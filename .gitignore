# ------------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
[Tt]est[Rr]esult*/
[Tt]est[Rr]esults/
*.pdb
*.cache
*.docstates
*.nupkg
*.snupkg
*.suo
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET / IIS Express / App Data
App_Data/
_ReSharper*/
*.ReSharper

